# csi_tx: classic ESP32 (ESP-WROOM-32U, NodeMCU-style board)
CONFIG_IDF_TARGET="esp32"
# 4 MB works on any WROOM-32U (4/8/16 MB parts)
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
# Console on UART0 = the board's USB-UART bridge (CP2102/CH340), 115200 baud
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
CONFIG_ESP_CONSOLE_UART_BAUDRATE=115200
# Steady timing
CONFIG_FREERTOS_HZ=1000
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_PM_ENABLE=n
# Keep stray log lines short so HELLO/STATS stay readable
CONFIG_LOG_DEFAULT_LEVEL_WARN=y
CONFIG_APP_REPRODUCIBLE_BUILD=y
